{
  "name": "dsh-remote-control",
  "version": "0.4.1",
  "description": "Copy-and-paste DSH pairing, remote windows, and one-click control handoff",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./companion": "./companion/index.js",
    "./package.json": "./package.json",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "window.js",
    "lib",
    "companion/index.js",
    "companion/lib",
    "vendor",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/juniper234/dsh-remote-control.git",
    "directory": "packages/remote-control"
  }
}
